# name: benchmark/semantic_benchmark/q3.benchmark
# description: Find the language of each Movie. Return title, language.
# group: [semantic_benchmark]

name Find the language of each Movie. Return title, language.
group semantic_benchmark

require httpfs load_only

cache semantic_benchmark.duckdb

load benchmark/semantic_benchmark/init/load.sql

run
SELECT title, LLM llama3 (PROMPT 'what is the  {language VARCHAR} of the movie {{title}}')
FROM movie;
