# name: benchmark/semantic_benchmark/q5.benchmark
# description: Summarize the cinematography style of each director who has directed more than 3 movies. Return director_name, movie_count, style.
# group: [semantic_benchmark]

name Summarize the cinematography style of each director who has directed more than 3 movies. Return director_name, movie_count, style.
group semantic_benchmark

load

run
SELECT n.name as director_name, count(*) AS movie_count, LLM AGG o4-mini (PROMPT 'Summarize the cinematography style of these movie plots {{mi.info}}') AS summary
FROM movie m
JOIN movie_info mi ON m.id = mi.movie_id
JOIN info_type it ON mi.info_type_id = it.id
JOIN cast_info ci ON m.id = ci.movie_id
JOIN name n ON ci.person_id = n.id
JOIN role_type rt ON ci.role_id = rt.id
WHERE rt.role = 'director' AND it.info = 'plot'
GROUP BY n.name
HAVING movie_count > 3;